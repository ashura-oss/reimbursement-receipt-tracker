<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <include domain="file" path="." requireFlags="clientSideEncryption" />
        <exclude domain="file" path="receipt-images" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="receipt-images" />
    </device-transfer>
</data-extraction-rules>
